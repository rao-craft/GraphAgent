{
  "mappings": ["node: GraphNode id=id level=level text=text neighbours=neighborIds"],
  "imports": ["SeerKit"],
  "look": [
    "title = Font.brandTitle",
    "note = Font.brandNote",
    "note2 = Font.brandNote2",
    "accent = Color.accent"
  ],
  "strings": [
    "title =",
    "hub = L{level} Hub",
    "leaf = Leaf",
    "loading = Connecting…",
    "empty = Add your first document to see your knowledge graph.",
    "retry = Retry"
  ],
  "tuning": [
    "hubRadius = 0.45",
    "hubRadiusStep = 0.18",
    "leafRadius = 0.18",
    "leafRadiusSpread = 0.04",
    "bodySeed = 19106",
    "layout = force",
    "layoutSeed = 417352",
    "hubLeaves = named",
    "edgeRadius = 0.022",
    "clayDetail = 0.63",
    "cameraDistance = 12",
    "pulseScale = 1.12",
    "pulseDuration = 1",
    "excerpt = 240",
    "badgeSize = 12",
    "panelRadius = 20",
    "panelMaterial = ultraThin",
    "showAnimation = .spring(response: 0.4, dampingFraction: 0.8)"
  ],
  "launch": ["atlas = graph(space-001)"]
}
